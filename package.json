{
  "name": "@asmyshlyaev177/design-tokens",
  "version": "1.1.1",
  "description": "OKLCH design tokens with a checked WCAG contrast contract, shared across asmyshlyaev177's sites",
  "keywords": [
    "accessibility",
    "apca",
    "axe-core",
    "contrast",
    "css-custom-properties",
    "design-tokens",
    "light-dark",
    "oklch",
    "playwright",
    "wcag"
  ],
  "license": "MIT",
  "author": "Aleksandr Smyshliaev <asmyshlyaev177@gmail.com>",
  "homepage": "https://asmyshlyaev177.dev/design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asmyshlyaev177/design-tokens.git"
  },
  "bugs": "https://github.com/asmyshlyaev177/design-tokens/issues",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./lighthouse": {
      "types": "./dist/lighthouse.d.mts",
      "default": "./dist/lighthouse.mjs"
    },
    "./package.json": "./package.json",
    "./contrast": {
      "types": "./dist/contrast.d.mts",
      "default": "./dist/contrast.mjs"
    },
    "./axe": {
      "types": "./dist/axe.d.mts",
      "default": "./dist/axe.mjs"
    }
  },
  "bin": {
    "check-tokens": "dist/bin/check-tokens.mjs"
  },
  "files": [
    "dist",
    "tokens.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "check": "node src/bin/check-tokens.ts src/tokens.css",
    "lint": "prettier --check .",
    "prepublishOnly": "pnpm build",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@axe-core/playwright": ">=4.8",
    "@playwright/test": ">=1.40",
    "lighthouse": ">=11",
    "playwright-lighthouse": ">=4"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "lighthouse": {
      "optional": true
    },
    "playwright-lighthouse": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.3.0",
    "apca-w3": "^0.1.9",
    "colorparsley": "^0.1.8",
    "prettier": "^3.6.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "packageManager": "pnpm@11.1.0"
}
