{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    /* Playwright's and vitest's declarations pull in globals this package
       does not use. Checking them proves nothing about our code. */
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* Relative imports carry a `.ts` extension so `pnpm check` can run
       src/bin/check-tokens.ts through node's type stripping, unbuilt. */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,

    "noEmit": true
  },
  "include": ["src", "test", "types", "*.ts"]
}
